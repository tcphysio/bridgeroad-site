{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/stamp-assets.js",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sessions.html",
      "destination": "/fees.html",
      "permanent": true
    },
    {
      "source": "/sessions",
      "destination": "/fees.html",
      "permanent": true
    },
    {
      "source": "/Thihan.jpeg",
      "destination": "/thihan-chandramohan-physiotherapist-richmond.jpeg",
      "permanent": true
    },
    {
      "source": "/thihan.jpeg",
      "destination": "/thihan-chandramohan-physiotherapist-richmond.jpeg",
      "permanent": true
    },
    {
      "source": "/new-patient-offer-source.html",
      "destination": "/new-patient-offer",
      "permanent": true
    },
    {
      "source": "/physio-richmond.html",
      "destination": "/physio-richmond",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/new-patient-offer",
      "destination": "/api/new-patient-offer"
    },
    {
      "source": "/physio-richmond",
      "destination": "/physio-richmond.html"
    }
  ],
  "functions": {
    "api/new-patient-offer.js": {
      "includeFiles": "new-patient-offer-source.html"
    },
    "api/chat.js": {
      "includeFiles": "*.html",
      "maxDuration": 60
    }
  }
}
